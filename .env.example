# Environment variables for the Malindi Business Network app.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored (see .gitignore).

# ---------------------------------------------------------------------------
# Firebase Web App configuration for the Firebase project:
#   Project name : Malindi Business Network
#   Project ID   : malindi-business-network
#   Project number: 434794990205
#
# The Web App MUST first be registered in the Firebase Console:
#   Firebase Console -> Malindi Business Network -> Project settings
#   -> General -> Your apps -> Add app -> Web
#   (app name can be "Malindi Business Network Mobile")
#
# Copy the generated config values below. Use ONLY this project's keys —
# never the SokoHapa (sokohapa-20744) project's keys.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY="<apiKey-from-firebase-console>"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="malindi-business-network.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="malindi-business-network"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="malindi-business-network.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="434794990205"
EXPO_PUBLIC_FIREBASE_APP_ID="<appId-from-firebase-console>"

# ---------------------------------------------------------------------------
# Supabase (used for profile/business image storage). Same project as before;
# the publishable key is a safe client-side identifier.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://fmkhrsjsaelvertrqcwu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# ---------------------------------------------------------------------------
# Backend URL — used for the KSh 100/month M-Pesa STK Push (membership).
# This still points at the shared SokoHapa backend until the MBN backend is
# separated (decided separately, not part of this Firebase task).
#   Android emulator: http://10.0.2.2:3000
#   Physical phone:   http://<YOUR_LAN_IP>:3000
#   Production:       https://<mbn-backend-url>
# ---------------------------------------------------------------------------
EXPO_PUBLIC_BACKEND_URL=REPLACE_WITH_BACKEND_URL