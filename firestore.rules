// Malindi Business Network - production Cloud Firestore security rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userData(userId) {
      let p = /databases/$(database)/documents/users/$(userId);
      return exists(p) ? get(p).data : null;
    }

    function businessData(businessId) {
      let p = /databases/$(database)/documents/businesses/$(businessId);
      return exists(p) ? get(p).data : null;
    }

    function isBusinessOwner(businessId) {
      let b = businessData(businessId);
      return isSignedIn() &&
             b != null &&
             b.ownerUid == currentUid();
    }

    // Advertisement types accepted by the network, in sync with
    // src/utils/adTypes.js AD_TYPES keys. Extend both lists together.
    function validAdType(value) {
      return value in [
        'promote_business',
        'promote_product',
        'promote_service',
        'looking_partner',
        'looking_supplier',
        'looking_customers',
        'looking_employees',
        'investment_opportunity',
        'special_offer'
      ];
    }

    function validAdStatus(value) {
      return value in ['active', 'inactive', 'draft'];
    }

    // True when a business owner's profile describes an ACTIVE membership
    // (KSh 100/month) that entitles them to post NEW advertisements on the
    // Business Stage. Uses the same KSh 100 monthly subscription fields the
    // backend writes after the M-PESA callback, evaluated with server-side
    // time (request.time), and fails closed when the expiry is missing or not
    // a Firestore Timestamp.
    function businessEntitled(userId) {
      let p = userData(userId);
      return p != null &&
             p.subscriptionStatus == 'active' &&
             (
               !('subscriptionExpiryDate' in p) ||
               p.subscriptionExpiryDate == null ||
               (
                 p.subscriptionExpiryDate is timestamp &&
                 p.subscriptionExpiryDate > request.time
               )
             );
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // Users may create only their own profile.
      allow create: if isSignedIn() &&
        uid == currentUid() &&
        request.resource.data.uid == currentUid() &&
        request.resource.data.role in [
          'member',
          'business',
          'buyer',
          'vendor',
          'delivery'
        ] &&
        (
          !(request.resource.data.role in ['vendor', 'business']) ||
          request.resource.data.subscriptionStatus == 'inactive' ||
          request.resource.data.subscriptionStatus == null
        ) &&
        // Registration writes exactly this field set (AuthContext.register);
        // anything else is rejected so the profile shape stays strict.
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'fullName',
          'phone',
          'profilePhoto',
          'createdAt',
          'updatedAt',
          'storeName',
          'subscriptionStatus',
          'subscriptionStartDate',
          'subscriptionExpiryDate',
          'vehicleType',
          'vehiclePlateNumber'
        ]);

      // IMPORTANT:
      // Users can read:
      // - their own profile
      // - delivery partner profiles
      // - vendor profiles
      // - business owner profiles
      //
      // Buyers need vendor-profile access because StoreScreen loads
      // the vendor information belonging to a store.
      allow get: if isSignedIn() &&
        (
          uid == currentUid() ||
          (resource.data != null &&
           resource.data.role == 'delivery') ||
          (resource.data != null &&
           resource.data.role == 'vendor') ||
          (resource.data != null &&
           resource.data.role == 'business')
        );

      // Only a VENDOR may query the delivery directory. Restricting the list
      // to the vendor role prevents any other signed-in user from enumerating
      // every delivery partner's whole profile document. The only consumer is
      // the vendor's ChooseDeliveryScreen (creating a delivery request).
      allow list: if isSignedIn() &&
        resource.data != null &&
        resource.data.role == 'delivery' &&
        userData(currentUid()) != null &&
        userData(currentUid()).role == 'vendor';

      // Users can only update their own profile.
      // Only these fields may be changed.
      allow update: if isSignedIn() &&
        uid == currentUid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profilePhoto',
          'availability',
          'mpesaPaymentMethods',
          'updatedAt'
        ]) &&
        // The vendor's M-PESA payment methods are a fixed-shape map: optional
        // Send Money phone number and Buy Goods Till number, both strings.
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['mpesaPaymentMethods']) == false ||
          (
            (request.resource.data.mpesaPaymentMethods != null
              ? request.resource.data.mpesaPaymentMethods.diff(
                  resource.data.mpesaPaymentMethods != null
                    ? resource.data.mpesaPaymentMethods
                    : {}
                ).affectedKeys().hasOnly(['sendMoneyNumber', 'tillNumber'])
              : true) &&
            (
              request.resource.data.mpesaPaymentMethods == null ||
              request.resource.data.mpesaPaymentMethods.sendMoneyNumber == null ||
              request.resource.data.mpesaPaymentMethods.sendMoneyNumber is string
            ) &&
            (
              request.resource.data.mpesaPaymentMethods == null ||
              request.resource.data.mpesaPaymentMethods.tillNumber == null ||
              request.resource.data.mpesaPaymentMethods.tillNumber is string
            )
          )
        );
    }

    // ============================================================
    // PUSH NOTIFICATION TOKENS
    // ============================================================
    // Each signed-in user stores their own device Expo push tokens under
    // pushTokens/{uid}/tokens/{deviceId}. The mobile app writes these only for
    // its own UID; the Cloud Functions (the actual push senders) read them
    // with the admin SDK, which bypasses these rules. No user can ever read or
    // write another user's token records.

    match /pushTokens/{uid} {

      // The parent document contains no data; nothing is granted on it.
      allow get, list: if false;
      allow create, update, delete: if false;

      match /tokens/{deviceId} {

        allow get, list: if isSignedIn() &&
          uid == currentUid();

        allow create: if isSignedIn() &&
          uid == currentUid() &&
          request.resource.data.uid == uid &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.enabled == true;

        allow update: if isSignedIn() &&
          uid == currentUid() &&
          resource.data != null &&
          resource.data.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0;

        allow delete: if isSignedIn() &&
          uid == currentUid();
      }
    }

    // ============================================================
    // NOTIFICATION EVENTS (server-side idempotency guards)
    // ============================================================
    // Created only by Cloud Functions with the admin SDK (which bypasses
    // these rules) so a single state transition can never double-notify.
    // Clients must never read, list, write or delete these documents.

    match /notificationEvents/{eventId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // ============================================================
    // BUSINESS PROFILES (Malindi Business Network)
    // ============================================================
    // A business profile lives at businesses/{ownerUid} - the owning user's
    // Firebase uid is the document id, so the owner can always read their own
    // record even before it becomes active. Public reads are limited to
    // businesses marked isActive, which keeps deactivated businesses hidden
    // from every public screen automatically.

    match /businesses/{businessId} {

      // The owner creates only their own business profile.
      allow create: if isSignedIn() &&
        businessId == currentUid() &&
        request.resource.data.businessId == businessId &&
        request.resource.data.ownerUid == currentUid() &&
        request.resource.data.isActive == true &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.keys().hasOnly([
          'businessId',
          'ownerUid',
          'ownerName',
          'businessName',
          'category',
          'description',
          'productsServices',
          'phone',
          'whatsapp',
          'location',
          'email',
          'businessHours',
          'profilePhoto',
          'isActive',
          'createdAt',
          'updatedAt'
        ]);

      // The owner may always read their own business; everyone else only when
      // the business is active.
      allow get: if isSignedIn() &&
        (
          businessId == currentUid() ||
          (resource.data != null &&
           resource.data.isActive == true)
        );

      // Public listings can only ever return active businesses.
      allow list: if isSignedIn() &&
        resource.data != null &&
        resource.data.isActive == true;

      // The owner may update only safe, non-identity fields on their own
      // business. Type checks apply only to fields actually being changed.
      allow update: if isBusinessOwner(businessId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName',
          'businessName',
          'category',
          'description',
          'productsServices',
          'phone',
          'whatsapp',
          'location',
          'email',
          'businessHours',
          'profilePhoto',
          'isActive',
          'updatedAt'
        ]) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['businessName', 'category']) == false ||
          (
            request.resource.data.businessName is string &&
            request.resource.data.businessName.size() > 0 &&
            request.resource.data.category is string &&
            request.resource.data.category.size() > 0
          )
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['description', 'phone', 'whatsapp', 'location', 'email', 'businessHours']) == false ||
          (
            request.resource.data.description is string &&
            request.resource.data.phone is string &&
            request.resource.data.whatsapp is string &&
            request.resource.data.location is string &&
            request.resource.data.email is string &&
            request.resource.data.businessHours is string
          )
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['productsServices']) == false ||
          request.resource.data.productsServices is list
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['profilePhoto']) == false ||
          (
            request.resource.data.profilePhoto == null ||
            request.resource.data.profilePhoto is string
          )
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']) == false ||
          request.resource.data.isActive is bool
        );

      // The owner can delete only their own business.
      allow delete: if isBusinessOwner(businessId);
    }

    // ============================================================
    // ADVERTISEMENTS (Business Stage)
    // ============================================================
    // One advertisement per document with a generated id, so a business can
    // post many times. A post is only visible publicly while its status is
    // 'active'; owners can always read their own posts in any state.

    match /advertisements/{adId} {

      // Only a business owner can create a post, and only against their own
      // business profile (businessId == ownerUid == currentUid). An active
      // KSh 100/month membership is required server-side at create time.
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == currentUid() &&
        request.resource.data.businessId == request.resource.data.ownerUid &&
        isBusinessOwner(request.resource.data.businessId) &&
        businessEntitled(request.resource.data.ownerUid) &&
        request.resource.data.type is string &&
        validAdType(request.resource.data.type) &&
        request.resource.data.status is string &&
        validAdStatus(request.resource.data.status) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.keys().hasOnly([
          'ownerUid',
          'businessId',
          'type',
          'title',
          'description',
          'category',
          'location',
          'phone',
          'whatsapp',
          'image',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      // Owner can read their own posts in any state; everyone else only sees
      // active posts.
      allow get: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.ownerUid == currentUid() ||
          resource.data.status == 'active'
        );

      // A query can only ever return the caller's own posts or active posts.
      allow list: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.ownerUid == currentUid() ||
          resource.data.status == 'active'
        );

      // Owners may edit only their own posts, and only ad-content / state
      // fields. Ownership (ownerUid, businessId) can never be changed and the
      // type/status must remain within the accepted sets when modified.
      allow update: if isSignedIn() &&
        resource.data != null &&
        resource.data.ownerUid == currentUid() &&
        request.resource.data.ownerUid == currentUid() &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type',
          'title',
          'description',
          'category',
          'location',
          'phone',
          'whatsapp',
          'image',
          'status',
          'updatedAt'
        ]) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['type']) == false ||
          validAdType(request.resource.data.type)
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status']) == false ||
          validAdStatus(request.resource.data.status)
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['title']) == false ||
          (
            request.resource.data.title is string &&
            request.resource.data.title.size() > 0
          )
        );

      // Owners may delete only their own posts.
      allow delete: if isSignedIn() &&
        resource.data != null &&
        resource.data.ownerUid == currentUid();
    }

    // ============================================================
    // CATEGORIES (admin-managed reference data)
    // ============================================================
    // Holds the canonical business categories. Readable by every signed-in
    // user; only 'admin' role accounts may add, edit or delete categories.
    // (No admin account exists yet - this is ready for the moderation phase.)

    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() &&
        userData(currentUid()) != null &&
        userData(currentUid()).role == 'admin';
    }
  }
}
